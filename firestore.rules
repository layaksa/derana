rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'derana.apps@gmail.com' ||
        request.auth.token.email == 'layaksa.studio@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidSurvey(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 250 &&
             data.desa is string && data.desa.size() <= 150 &&
             data.bahasa is string && data.bahasa.size() <= 150;
    }

    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 150 &&
             data.displayName is string && data.displayName.size() <= 150;
    }

    // Survey Collection
    match /surveys/{surveyId} {
      allow read: if true; // Public read for linguistic research & dialect mapping
      allow create: if isValidId(surveyId) &&
                       isValidSurvey(incoming());
      allow update: if isValidId(surveyId) &&
                       isValidSurvey(incoming());
      allow delete: if isSignedIn() &&
                       isValidId(surveyId) &&
                       (isAdmin() || !('createdBy' in existing()) || existing().createdBy == request.auth.uid);
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isSignedIn() &&
                               isValidId(userId) &&
                               (request.auth.uid == userId || isAdmin()) &&
                               isValidUser(incoming());
      allow delete: if isAdmin();
    }

    // Vitalitas Collection (Kuesioner Kondisi Kebahasaan)
    match /vitalitas/{vitalitasId} {
      allow read: if true;
      allow create, update: if isValidId(vitalitasId);
      allow delete: if isSignedIn();
    }

    // Sastra Lisan Collection (Kuesioner Sastra Lisan & Motif)
    match /sastra_lisan/{recordId} {
      allow read: if true;
      allow create, update: if isValidId(recordId);
      allow delete: if isSignedIn();
    }

    // Revitalisasi Monev Collection (IKRBD Model C)
    match /revitalisasi_monev/{recordId} {
      allow read: if true;
      allow create, update: if isValidId(recordId);
      allow delete: if isSignedIn();
    }

    // Revitalisasi RAP Collection (Rencana Aksi Pengimbasan)
    match /revitalisasi_rap/{recordId} {
      allow read: if true;
      allow create, update: if isValidId(recordId);
      allow delete: if isSignedIn();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
