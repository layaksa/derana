rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'derana.apps@gmail.com' ||
        request.auth.token.email == 'layaksa.studio@gmail.com' ||
        request.auth.token.email.matches('.*admin.*') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Survey Collection
    match /surveys/{surveyId} {
      allow read: if true; // Public read for linguistic research & dialect mapping
      allow create: if isValidId(surveyId);
      allow update: if isValidId(surveyId);
      allow delete: if isSignedIn() && isValidId(surveyId) &&
                       (isAdmin() || !('createdBy' in existing()) || existing().createdBy == request.auth.uid);
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Vitalitas Collection (Kuesioner Kondisi Kebahasaan)
    match /vitalitas/{vitalitasId} {
      allow read: if true;
      allow create, update: if isValidId(vitalitasId);
      allow delete: if isSignedIn();
    }

    // Sastra Lisan Collection (Kuesioner Sastra Lisan & Motif)
    match /sastra_lisan/{recordId} {
      allow read: if true;
      allow create, update: if isValidId(recordId);
      allow delete: if isSignedIn();
    }

    // Revitalisasi Monev Collection (IKRBD Model C)
    match /revitalisasi_monev/{recordId} {
      allow read: if true;
      allow create, update: if isValidId(recordId);
      allow delete: if isSignedIn();
    }

    // Revitalisasi RAP Collection (Rencana Aksi Pengimbasan)
    match /revitalisasi_rap/{recordId} {
      allow read: if true;
      allow create, update: if isValidId(recordId);
      allow delete: if isSignedIn();
    }

    // Role Requests Collection
    match /role_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Activity Logs Collection (Log Aktivitas & Riwayat Perubahan Surveyor)
    match /activity_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
